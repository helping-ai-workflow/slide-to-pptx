{
  "name": "@helping-ai-workflow/slide-to-pptx",
  "version": "0.4.1",
  "description": "Render React/HTML slide decks to PowerPoint (.pptx) via Playwright + pptxgenjs",
  "keywords": [
    "pptx",
    "powerpoint",
    "slides",
    "react",
    "playwright",
    "pptxgenjs"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "slide-to-pptx": "./bin/slide-to-pptx.cjs"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "scripts/",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.24.0",
    "fast-xml-parser": "^5.8.0",
    "jszip": "^3.10.1",
    "playwright": "^1.60.0",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsdown": "^0.9.9",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "spike": "tsx src/cli.ts ../my-slide/slides/mac-merge-tx-spec",
    "build": "tsdown",
    "prepack": "npm run build",
    "test": "node --import tsx --test $(find tests -name '*.test.ts' -not -name 'corpus.test.ts')",
    "test:corpus": "node --import tsx --test tests/corpus.test.ts",
    "test:all": "node --import tsx --test $(find tests -name '*.test.ts')",
    "pre-release": "node --import tsx scripts/visual-regression.mjs",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helping-ai-workflow/slide-to-pptx.git"
  },
  "homepage": "https://github.com/helping-ai-workflow/slide-to-pptx#readme",
  "bugs": "https://github.com/helping-ai-workflow/slide-to-pptx/issues",
  "author": "helping-ai-workflow",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
