{
  "name": "@helping-ai-workflow/slide-to-pptx",
  "version": "0.1.15",
  "description": "Render React/HTML slide decks to PowerPoint (.pptx) via Playwright + pptxgenjs",
  "keywords": [
    "pptx",
    "powerpoint",
    "slides",
    "react",
    "playwright",
    "pptxgenjs"
  ],
  "type": "module",
  "bin": {
    "slide-to-pptx": "./bin/slide-to-pptx.cjs"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.24.0",
    "fast-xml-parser": "^5.8.0",
    "jszip": "^3.10.1",
    "playwright": "^1.60.0",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "spike": "tsx src/cli.ts ../my-slide/slides/mac-merge-tx-spec",
    "test": "node --import tsx --test 'tests/**/*.test.ts'",
    "test:corpus": "node --import tsx --test 'tests/corpus.test.ts'",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helping-ai-workflow/slide-to-pptx.git"
  },
  "homepage": "https://github.com/helping-ai-workflow/slide-to-pptx#readme",
  "bugs": "https://github.com/helping-ai-workflow/slide-to-pptx/issues",
  "author": "helping-ai-workflow",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
